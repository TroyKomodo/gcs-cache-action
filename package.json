{
  "name": "gcs-cache-action",
  "version": "1.0.3",
  "description": "Cache your workload to a Google Cloud Storage bucket",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "package": "pnpm run build && ncc build lib/main.js -m -o dist/main && ncc build lib/post.js -m -o dist/post",
    "test": "jest --passWithNoTests",
    "prepare": "husky install",
    "release": "np --message=\"chore: v%s\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MansaGroup/gcs-cache-action.git"
  },
  "keywords": [
    "actions",
    "gcs",
    "google-cloud",
    "cache"
  ],
  "author": "Jérémy Levilain <jeremy.levilain@getmansa.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MansaGroup/gcs-cache-action/issues"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{md,yml,html,css,scss,json}": "prettier --write"
  },
  "homepage": "https://github.com/MansaGroup/gcs-cache-action#readme",
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/semver": "7.3.13",
    "@types/tmp": "0.2.3",
    "@typescript-eslint/eslint-plugin": "8.26.0",
    "@typescript-eslint/parser": "8.26.0",
    "@vercel/ncc": "0.38.3",
    "eslint": "9.21.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "10.0.2",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-import-helpers": "2.0.1",
    "eslint-plugin-jest": "28.11.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-sonarjs": "3.0.2",
    "eslint-plugin-unused-imports": "4.1.4",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-circus": "29.7.0",
    "lint-staged": "15.4.3",
    "np": "10.2.0",
    "prettier": "3.5.3",
    "ts-jest": "29.0.5",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@actions/core": "1.10.0",
    "@actions/exec": "1.1.1",
    "@actions/github": "6.0.0",
    "@actions/glob": "0.5.0",
    "@google-cloud/storage": "7.15.2",
    "semver": "7.7.1",
    "tmp-promise": "3.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
